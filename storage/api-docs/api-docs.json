    "paths": {
        "/auth/login": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Iniciar sesión",
                "operationId": "f1b1b78820123329e1c186330d7d1d04",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "correo",
                                    "password"
                                ],
                                "properties": {
                                    "correo": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "junior.arias02yt@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "qweasdzxc"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Genera el Token JWT",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "mensaje": {
                                            "type": "string",
                                            "example": "Sesión iniciada con éxito."
                                        },
                                        "datos": {
                                            "properties": {
                                                "token": {
                                                    "type": "string",
                                                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                                                },
                                                "tipo_token": {
                                                    "type": "string",
                                                    "example": "bearer"
                                                },
                                                "expira_en": {
                                                    "type": "integer",
                                                    "example": 3600
                                                }
                                            },
                                            "type": "object"
                                        },
                                        "error": {
                                            "type": "boolean",
                                            "example": false
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Credenciales inválidas",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "mensaje": {
                                            "type": "string",
                                            "example": "Credenciales incorrectas."
                                        },
                                        "datos": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "error": {
                                            "type": "boolean",
                                            "example": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/auth/registro": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Crear cuenta / Registrar usuario",
                "operationId": "8d951602d4f04abc226efdb9dc8d9911",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "nombre",
                                    "correo",
                                    "password",
                                    "rol",
                                    "estado"
                                ],
                                "properties": {
                                    "nombre": {
                                        "type": "string",
                                        "example": "Junior Arias"
                                    },
                                    "correo": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "junior.arias02yt@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "qweasdzxc"
                                    },
                                    "rol": {
                                        "type": "string",
                                        "example": "DOCENTE",
                                        "enum": [
                                            "ADMIN",
                                            "DOCENTE",
                                            "EDITOR"
                                        ]
                                    },
                                    "estado": {
                                        "type": "string",
                                        "example": "ACTIVO",
                                        "enum": [
                                            "ACTIVO",
                                            "INACTIVO"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Cuenta creada exitosamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "mensaje": {
                                            "type": "string",
                                            "example": "Usuario registrado con éxito."
                                        },
                                        "datos": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 2
                                                },
                                                "nombre": {
                                                    "type": "string",
                                                    "example": "Junior Arias"
                                                },
                                                "correo": {
                                                    "type": "string",
                                                    "example": "junior.arias02yt@gmail.com"
                                                },
                                                "rol": {
                                                    "type": "string",
                                                    "example": "DOCENTE"
                                                },
                                                "estado": {
                                                    "type": "string",
                                                    "example": "ACTIVO"
                                                }
                                            },
                                            "type": "object"
                                        },
                                        "error": {
                                            "type": "boolean",
                                            "example": false
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
